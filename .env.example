HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Pi provider and model catalog identifiers.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Optional generic override. Provider-native variables such as OPENAI_API_KEY,
# ANTHROPIC_API_KEY, GEMINI_API_KEY, or OPENROUTER_API_KEY also work.
LLM_API_KEY=

# Knowledge Provider. Mock is deterministic and requires no external service.
KNOWLEDGE_PROVIDER=mock

# Required only when KNOWLEDGE_PROVIDER=ragflow. Never commit real secrets.
RAGFLOW_BASE_URL=https://ragflow.example.com
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=dataset-id-1,dataset-id-2
RAGFLOW_TIMEOUT_MS=10000
